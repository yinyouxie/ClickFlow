<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ClickFlow</RootNamespace>
    <AssemblyName>ClickFlow</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.2.1</Version>
    <FileVersion>1.2.1.0</FileVersion>
    <Company>ClickFlow</Company>
    <Product>轻录 ClickFlow</Product>
    <Description>鼠标键盘录制与回放工具</Description>
    <Copyright>Copyright (c) 2026 ClickFlow</Copyright>
    <SatelliteResourceLanguages>zh-CN</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>$(NoWarn);WFO1000;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
    <EmbeddedResource Include="Assets\app.ico" LogicalName="ClickFlow.app.ico" />
  </ItemGroup>

</Project>
